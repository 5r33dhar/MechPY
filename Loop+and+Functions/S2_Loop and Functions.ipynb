import numpy as np
import matplotlib.pyplot as plt
x = np.linspace(0,5,50)

X = []
Y = []
for n in x:
    if n <= 2.5:
        y = n**2
    elif n > 2.5:
        y = n**2.5
    X.append(n)
    Y.append(y)
    
plt.plot(X,Y)
plt.show()
