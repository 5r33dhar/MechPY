{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMk60DwTgHsuIzYkRjLicSn"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["!apt-get install tcl8.6"],"metadata":{"id":"aV30onRPBAJN"},"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"2lw819LM_5S5"},"outputs":[],"source":["#output examples\n","puts \"Hello, World!\"\n","puts {hi this a test }\n","puts \"###########\";\n","\n","\n","# exmples of two commands in oneline\n","puts {hi this a test };puts \"Hello, World!\";# useing ; to end command\n","puts \"This is line 1\"; puts {This is line 2}; #Note after the ;\n","puts \"###########\";\n","\n","\n","#set  to make varable\n","set software  \"hypwermesh \";\n","set os \"windows\"\n","puts \"the $software use is $os  \"\n","puts \"###########\";\n","\n","#set  to make varable  Variable substitution\n","set Z Albany\n","set Z_LABEL \"The Capitol of New York is: \"\n","puts \"$Z_LABEL $Z\"; #Prints the value of Z\n","puts \"$Z_LABEL   \\$Z\"; #Prints a literal $Z instead of the value of Z\n","puts \"###########\";\n","\n","#Variable substitution with braces ({}).\n","#• Braces disable the substitution of variables with braces.\n","set Z Albany\n","set Z_LABEL \"The Capitol of New York is: \"\n","puts \"$Z_LABEL $Z\"\n","puts {$Z_LABEL $Z}\n","\n","puts \"###########\";\n","\n","# puts  option on valables with braces ({}).\n","set city \"vizag\"\n","set stament \"this city is\"\n","puts \"$stament $city\";\n","puts {$stament $city};\n","puts ($stament$city) ;\n","puts $stament$city ;\n","puts $stament\"\"$city ;\n","#puts $stament $city ; does not work\n","puts \"###########\";\n","\n","#Use to ^| recall your latest command.\n","\n","puts \"###########\";\n","\n","#Multiple variable substitution.\n","set month 2\n","set day 3\n","set year 09\n","set date \"$month:$day:$year\"\n","puts $date\n","puts \"###########\";\n","\n","\n","#Using eval command.\n","set foo \"puts hi\"\n","eval $foo\n","puts \"###########\";\n","\n","#Square brackets ([ ]) are used to achieve command substitution.\n","set my_height 6.0\n","puts \"If I was 2 inches taller, I would be [expr $my_height + (2.0 / 12.0)] feet tall\"\n","#puts $expr does not work\n","puts \"###########\";\n","\n","#Lists simple way to group items. Deal with the collection of items as a single entity.\n","\n","#A string:\n","puts \"###########\";\n","set lst \"itemX itemY itemZ\"\n","puts \"$lst output is a string \"\n","# A variable to be a list of value\"s:\n","set lst {{item1} {item2} {item3}}\n","puts \"$lst A variable to be a list of value without using list \"\n","puts \"###########\";\n","#Using the split command:\n","set lst1 [split \"item1.item2.item3\" \".\"]\n","set lst2 [split \"item1,item2,item3\" \",\"]\n","puts \"$lst1 using split as .\"\n","puts \"$lst2 using split as ,\"\n","puts \"###########\";\n","#Using the list command:\n","set lst [list \"item1\" \"item2\" \"item3\"]\n","puts \"$lst using list \"\n","set a \"item1\"; set b \"item2\"; set c \"item3\"\n","set lst [list $a $b $c]\n","puts \"$lst using list \"\n","puts \"###########\";\n","\n","#An individual member of a list can be accessed with lindex.\n","\n","set lst1 [split \"John,Joe,Mary,Susan\" \",\"];# no space  , try space\n","puts \"$lst1 using split as ,\"\n","puts \"###########\";\n","\n","\n","set simple_list \"0John 1Joe 2Mary 3Susan\"\n","#index of elemts atarting from 0\n","puts [lindex $simple_list 0]\n","puts [lindex $simple_list 2]\n","puts [lindex $simple_list 1]\n","puts [lindex $simple_list end]\n","puts [lindex $simple_list end-2]\n","puts [lindex $simple_list end-1]\n","puts [lindex $simple_list end-3]\n","puts \"###########\";\n","\n","\n","#The length of a list can be determined with llength.\n","\n","set names {Canada India USA UK}\n","puts $names\n","puts {$names \"  as  strings\" }\n","puts \"List length is: [llength $names]\"\n","#Note: With lappend the name of a variable containing the list (names) is used rather than the list itself ($names).\n","puts \"###########\";\n","\n","# a list contains a particular element using lsearch.\n","\n","puts \"[lsearch {a b c d e} c]\"\n","puts \"[lsearch -all {a b c a b c} c]\"\n","puts \"[lsearch -inline  {a20 b35 c47} b*]\"\n","puts \"[lsearch -inline -not {a20 b35 c47} b*]\"\n","puts \"[lsearch -inline -not -all {a20 b35 c47} b*]\"\n","puts \"###########\";\n","\n","#A value can be removed from a list using lremove.\n","\n","set names {Canada India air USA UK}\n","puts $names\n","puts {$names \"  as  strings\" }\n","puts \"List words length is: [llength $names]\"\n","\n","#set newnames [lremove $names India];# not working\n","#puts \"New list is: $newnames\"\n","#puts \"List length is: [llength $names]\"\n","\n","puts \"###########\";\n","\n","\n","#A list can be appended to using lappend.\n","\n","set names {Canada India USA UK}\n","set newnames [lappend names China]\n","puts \"New list is: $newnames\"\n","# With lappend the name of a variable containing the list (names) is used rather than the list itself ($names).\n","#Note: With lappend the name of a variable\n","#containing the list (names) is used rather than\n","#the list itself ($names).\n","puts \"###########\";\n","\n","#Lists can be sorted with lsort.\n","\n","puts [lsort \"4 1 9\"]\n","puts [lsort \"D A Z T\"]\n","puts [lsort \"D 4 9 A Z 1 T\"]\n","puts \"###########\";\n","\n","#lsort must be used in combination with -integer or -real to sort integers or reals.\n","\n","set myValues \"1 2 11 12 3 21 22 03 0004 -6\"\n","puts \"[lsort $myValues] sort with first value \"\n","puts \"[lsort -real $myValues] sort with number line  value \"\n","puts \"[lsort -integer $myValues] sort with number line  value\"\n","\n","\n","#lsort can also be used to remove duplicate elements from a list, using -unique argument.\n","puts [lsort -unique \"4 1 9 2 1 4 2 3 9\"]\n","puts \"###########\";\n","\n","\n","#lrange allows to extract parts of lists.\n","\n","set l [list a b c d e f g]\n","#           0 1 2 3 4 5 6\n","puts [lrange $l 0 4]\n","puts \"[lrange $l 4 end] Given 4(e) to end(g)\"\n","puts \"[lrange $l 3 end-1] Given 3(d) to end-1(f)\"\n","puts \"###########\";\n","\n","#Strings (string) are a set of alphanumeric characters stored and manipulated together.\n","#All data items in Tcl, including numeric values, are treated as strings.\n","\n","set str \"This is Canada\"\n","#       \"0123456789...13\"\n","puts \"The string is: $str\"\n","puts \"The length of the string is: [string length $str]\"\n","puts \"The character at index 3 is: [string index $str 0]\"\n","puts \"List word length is: [llength $str]\"\n","puts \"The characters from index 3 through end are: [string range $str 3 end]\"\n","puts \"The index of the first occurrence of letter \\\"i\\\" is: [string first i $str]\"\n","\n","####################################################################\n","puts \"#################################################\";\n","#Comparisons & Loops\n","#• Decision making commands:\n","#     • If-else statements\n","#     • Switch statement\n","#• Looping statements:\n","#       • while\n","#       • for\n","#       • foreach\n","#Note: Commands can alter the flow of execution in response to some condition.\n","puts \"####################Comparisons & Loops#############################\";\n","puts \"#################################################\";\n","###########################################################\n","puts \"###########if-else statements\";\n","#Using if-else statements:\n","#if test1 body1? elseif test2 body2 elseif ...? ?else body?\n","\n","set k 35\n","if {$k == 35}  {\n","        puts \"Handling is good.\"\n","                }  elseif {$k == 20}  {\n","        puts \"Ride is good.\"\n","                }   else {\n","        puts \"I am not sure of the quality of ride or handling.\"\n","        }\n","#indentations ({})are not required, but they make it easier to read the code.\n","\n","puts \"###########switch statements\";\n","\n","#Using switch statements:\n","#switch ?options? string {pattern body ?pattern body ...?}\n","\n","set num_legs 4\n","switch $num_legs {\n","          2 {puts \"It could be a human.\"}\n","          4 {puts \"It could be a cow.\"}\n","          6 {puts \"It could be an ant.\"}\n","          8 {puts \"It could be a spider.\"}\n","          default {puts \"It could be anything.\"}\n","            }\n","\n","puts \"###########while statements\";\n","\n","#Using while statements:\n","#while test body\n","\n","set i 0\n","    while {$i < 5} {\n","                    puts \"In the while loop, and i == $i\"\n","                    incr i 1\n","                    puts $i\n","                    }\n","\n","#Try to reflect on the differences between while and for statements!\n","\n","\n","\n","puts \"###########foreach statements\";\n","#Using foreach statements:\n","# foreach varName list body\n","\n","foreach vowel {a e i o u} {\n","                          puts \"$vowel is a vowel\"\n","                          puts \" [string length $vowel]\"\n","                          #puts \"[string index $vowel]\" single element\n","                           }\n","\n","\n","\n","#Using nested foreach statements:\n","puts \"########### nested foreach statements\";\n","\n","set BeamSectionWidth \"10 20 30\"\n","set BeamSectionHeight \"5 15 25\"\n","\n","# for each lenght in BeamSectionWidth\n","foreach length $BeamSectionWidth {\n","                          # for each height in BeamSectionHeight\n","                          foreach height $BeamSectionHeight {\n","                                 puts \" area section for length $length and height $height is [expr $length * $height]\"\n","                                                    }\n","                                  }\n","\n","\n","\n","#Using foreach statements with lists having the same length:\n","#• foreach varList list body\n","puts \"########### foreach varList list body\";\n","\n","set rankPlayerList [list Rank: \"First Name:\" \"Last Name:\" \"Age:\" 3 Roger Federer 12 1 Rafael Nadal 15 2 Novak Djokovic 30]\n","\n","# list Rank: \"First Name:\" \"Last Name:\" -> {rank first last}\n","foreach {rank first last Age} $rankPlayerList {\n","                              puts \"[format %-5s $rank] [format %-11s $first] [format %-10s $last] [format %-10s $Age]\"\n","                                    }\n","\n","#You need \\ if you use two lines in a script.\n","\n","puts \"########### nested foreach statements\"\n","#Using foreach statements:\n","#• foreach var1 List1 var2 List2 ... ... varN ListN body\n","#• Input: Automatically calculating the maximum length per column for dynamic formatting.\n","set rankPlayerList [list \"Rank:\" \"First Name:\" \"Last Name:\" 3 Roger Federer 1 Rafael Nadal 2 Novak Djokovic]\n","set varList {rLen fLen lLen}; set pInfoList {rank first last}\n","\n","foreach lVar $varList {set $lVar 0}\n","        foreach $pInfoList $rankPlayerList {\n","                foreach lVar $varList pInfo $pInfoList {\n","                        set $lVar [expr max([string length [set $pInfo]], [set $lVar])]\n","                                                      }\n","                                            }\n","foreach $pInfoList $rankPlayerList {\n","                            puts \"[format %-${rLen}s $rank]     [format %-${fLen}s $first]     [format %-${lLen}s $last]\"\n","                                  }\n","\n","\n","puts \"########### nested foreach statements\"\n","# Using for statements:\n","#• for init test reinit body\n","puts \"++1 {incr i 2}\"\n","for {set i 0} \\\n","    {$i < 5}  \\\n","    {incr i 1} {\n","            puts \"In the for loop,\n","                      and i == $i\"\n","                }\n","\n","#increiment  is incresed by 2 {incr i 2}\n","puts \"++2 {incr i 2}\"\n","for {set i 0} \\\n","    {$i < 5}  \\\n","    {incr i 2} {\n","            puts \"In the for loop,\n","                      and i == $i\"\n","                }\n","####################################################################\n","puts \"#################################################\";\n","#Expressions\n","#       • Expressions are evaluated using expr command.\n","#        • Mathematical and rational expressions allowed.\n","#Expressions consist of operands, operators, parenthesis.\n","#         • White space between these are allowed\n","\n","\n","#• Operands can be:\n","#• Numerical values\n","#     • Integer\n","#     • floating-point.\n","#• Tcl variable using $.\n","#       • String enclosed in double quotes or braces.\n","#• Tcl command enclosed in brackets.\n","\n","\n","puts \"####################Expressions#############################\";\n","puts \"#################################################\";\n","###########################################################\n","\n","#• Rational Expression: 0 is false; 1 is true\n","#     • Input: expr 0 == 1\n","#    ##  • Output: 0\n","#     •  Input: expr 1 == 1\n","#     ##• Output: 1\n","#• Mathematical Expression\n","#   ##• Input: expr 4 + 5\n","#   ###• Output: 9\n","\n","#Rational Expression: 0 is false; 1 is true\n","set value [expr 0 == 1]\n","puts \"$value False\"\n","\n","set value [expr 1 == 1]\n","puts \"$value True\"\n","\n","#Mathematical Expression\n","set value [expr 4 + 5]\n","puts \"$value = expr 4 + 5\"\n","\n","#• Mathematical functions supported in expressions:\n","set value [expr sin(2)]\n","puts \"$value = expr sin(2)\"\n","\n","set Pi [expr (atan(1) * 4)]\n","puts \"$Pi = expr (atan(1) * 4)\"\n","\n","#FUNCTION\n","#abs cosh log sqrt\n","#acos double log10 srand\n","#asin exp pow tan\n","#atan floor rand tanh\n","#atan2 fmod round wide\n","#ceil hypot sin\n","#cos int sinh\n","\n","#set lista {}\n","#puts $list\n","set i 10\n","#puts $i\n","set listN [lappend lista $i]\n","puts $listN\n","\n","#Example1\n","#• Create a list with the 10 values here after:\n","#2, 4, 6, 8, 10, 20, 40, 60, 80, 100.\n","puts \"Example Test1\"\n","puts \"++2 {incr i 2}\"\n","set lista {}\n","puts \"$lista empty\"\n","for {set i 2} \\\n","    {$i < 12}  \\\n","    {incr i 2} {\n","            set listN [lappend lista $i]\n","            puts \"listN is $listN  \"\n","            puts \"In the for loop,and i == $i\"\n","                }\n","for  {set i 20} \\\n","     {$i < 70}  \\\n","     {incr i 10} {\n","                 set listN [lappend lista $i]\n","                puts \"listN is $listN  \"\n","                puts \"In the for loop,and i == $i\"\n","                }\n","for  {set i 80} \\\n","     {$i < 110}  \\\n","     {incr i 20} {\n","                 set listN [lappend lista $i]\n","                puts \"listN is $listN  \"\n","                puts \"In the for loop,and i == $i\"\n","                }\n","\n","#Example2\n","#Run a loop to compute the square root of each value  \\\n","of the list.\n","\n","puts \"Example Test2\"\n","puts \"list  of  $listN \"\n","set len [llength $listN]\n","puts \"number of elements are $len\"\n","foreach ele $listN {\n","                    #puts $ele\n","                    set value [expr sqrt($ele)]\n","                    #puts $value\n","                    set SqList [lappend SqList $value]\n","                          }\n","\n","puts \"List  of  $listN \"\n","puts \"SqList  of  $SqList \"\n","\n","#Example3\n","#• Run a loop to plot each square root, in the increasing order.\n","\n","\n","puts \"#################################################\";\n","###########################################################\n","#Tcl Command - Advanced\n","#Arrays\n","\n","puts \"###################Arrays##############################\";\n","###########################################################\n","\n","#Arrays\n","#• Unlike arrays in many other languages, Tcl arrays are indexed by keywords.\n","#• Keywords can be easy to remember strings or integers. Values of the array elements can be strings or numbers.\n","#• A Tcl array is created when you assign the first array element.\n","\n","\n","set myArray(foo) \"bar\"\n","puts $myArray(foo)\n","\n","#• The array command is used in Tcl to manipulate array data and deal with multiple dimensions.\n","\n","array set fruitColors {tomato red banana yellow}\n","puts $fruitColors(tomato)\n","puts $fruitColors(banana)\n","#puts $fruitColors(yellow)\n","\n","\n","#• The whole array content can be printed out in the console using parray.\n","\n","array set fruitColors {tomato red banana yellow}\n","parray fruitColors\n","#Note: List must have an even number of elements!\n","\n","\n","##########################################################################\n","#parray output can’t be redirected to a file, but you can take the whole \\\n","procedure and swap the standard output channel (stdout) with an open \\\n","file handle.\n","\n","proc parray {a {pattern *}} {\n","\n","              upvar 1 $a array\n","                  if {![array exists array]} {\n","                            return -code error \"\\\"$a\\\" isn't an array\"\n","                        }\n","set maxl 0\n","set names [lsort [array names array $pattern]]\n","foreach name $names {if {[string length $name] > $maxl}\n","                                  {\n","                                    set maxl [string length $name]\n","                                   }\n","                      }\n","\n","\n","set maxl [expr {$maxl + [string length $a] + 2}]\n","foreach name $names {\n","                    set nameString [format %s(%s) $a $name]\n","                    puts stdout [format \"%-*s = %s\" $maxl $nameString\n","                                          $array($name)]\n","                     }\n","           }\n","####################################################################\n","\n","#• Check if an array exists:\n","array exist arrayname\n","#array exist fruitColors\n","\n","#• Unset an array:\n","array unset arrayname\n","\n","#• Can be coupled with catch command to avoid Tcl error if arrayname does not exist:\n","catch {array unset arrayname}\n","\n","\n","#• Interrogating an array:\n","#• Array name returns the element between square brackets [ ].\n","#• Array get returns a list with the element between parenthesis and its value.\n","array set fruitColors \"tomato red apple green ananas yellow orange orange\"\n","puts [array name fruitColors]\n","puts [array get fruitColors]\n","\n","#Arrays - Set up Example\n","#• Let’s see examples of array definition for reading a file (mat.txt) including material attributes:\n","#• Aluminium 2.7 69 .243\n","#• Steel 7.9 210 .3\n","#• Copper 8.96 124 .33\n","#• Gold 19.3 78 .42\n","#VIRTUAL\n","#Note: Find the material file at: ..\\01-Intro-to-Tcl-Tk\\Demo\\mat.txt\n","\n","\n","#Arrays - Set up Example 1\n","set InputFile [tk_getOpenFile]\n","set InputChannel [open $InputFile r]\n","while {![eof $InputChannel]} {\n","                        gets $InputChannel strLine\n","                        set MatDensity([lindex $strLine 0]) [lindex $strLine 1]\n","                        set MatYoung([lindex $strLine 0]) [lindex $strLine 2]\n","                        set MatPoisson([lindex $strLine 0]) [lindex $strLine 3]\n","                            }\n","foreach matname [array name MatDensity] {\n","                                set density [lindex $MatDensity($matname)]\n","                                  …\n","                    }\n","\n","#Arrays - Set up Example 2\n","set InputFile [tk_getOpenFile]\n","set InputChannel [open $InputFile r]\n","while {![eof $InputChannel]} {\n","                              gets $InputChannel strLine\n","                              set MatAttributes([lindex $strLine 0]) [lrange $strLine 1 3]\n","                              }\n","                close $InputChannel\n","foreach matname [array name MatAttributes] {\n","                              set density [lindex [lindex $MatAttributes($matname)] 0]\n","                                …\n","                                    }\n","#Note: Each array contains all material attributes in a list. The user then needs to query each index of the list.\n","\n","\n","#Arrays - Set up Example 3\n","set InputFile [tk_getOpenFile]\n","set InputChannel [open $InputFile r]\n","while {![eof $InputChannel]} {\n","                      gets $InputChannel strLine\n","                      set MatAttributes([lindex $strLine 0].dens) [lindex $strLine 1]\n","                      set MatAttributes([lindex $strLine 0].young) [lindex $strLine 2]\n","                      set MatAttributes([lindex $strLine 0].poisson) [lindex $strLine 3]\n","                      }\n","foreach matname [array name MatDensity *.dens] {\n","                                    set density [lindex $MatAttributes($matname)]\n","        }\n","#Note: With this terminology, you can define multiple dimensions and filter them if needed.\n","\n","#Arrays - Advanced Example\n","#• Input:\n","set playerArr(allPlayers) {\"Novak Djokovic\" \"Rafael Nadal\" \"Roger Federer\"}\n","set playerArr(pricemoney,1) {\"Novak Djokovic\" 150e6}\n","set playerArr(pricemoney,2) {\"Rafael Nadal\" 125e6}\n","set playerArr(pricemoney,3) {\"Roger Federer\" 90e6}\n","set playerArr(rankPlayer,Rafael\\ Nadal) 1\n","set playerArr(rankPlayer,Novak\\ Djokovic) 2\n","set playerArr(rankPlayer,Roger\\ Federer) 3\n","set playerArr(rank,1) \"Rafael Nadal\"\n","set playerArr(rank,2) \"Novak Djokovic\"\n","set playerArr(rank,3) \"Roger Federer\"\n","puts \"Top [llength $playerArr(allPlayers)] players are [join $playerArr(allPlayers) \", \"]\"\n","puts \"Highest Pricemoney = $[format %.2f [lindex $playerArr(pricemoney,1) 1]]\"\n","puts \"Won by = [set richestPlayer [lindex $playerArr(pricemoney,1) 0]]\"\n","puts \"Richest Player $richestPlayer ranked $playerArr(rankPlayer,$richestPlayer) in\n","the World\"\n","puts \"3rd ranked player is $playerArr(rank,3)\"\n","\n","###################################################\n","puts \"#################################################\";\n","#NAMESPACES AND PROCEDURES\n","puts \"####################NAMESPACES AND PROCEDURES#############################\";\n","#Namespaces\n","#• A namespace is a collection of commands and variables.\n","#• Create and manipulate contexts for commands and variables.\n","#• Encapsulates the commands and variables to ensure that they won't \\\n","interfere with the commands and variables of other namespaces.\n","#• Tcl has always had one such collection.\n","#• Which we refer to as the global namespace.\n","\n","\n","#• The namespace eval command lets you create new namespaces.\n","#• Input:\n","puts \"#################################################\";\n","#new namespaces.example namespace eval\n","set num 5\n","puts \"global num = $num\"\n","namespace eval test {\n","                     variable num 7\n","                      puts \"num in namespace [namespace current] = $num\"\n","                      proc testProc1 {} {\n","                                          variable num\n","                                          return \"num in testProc1 in namespace \\\n","                                          [namespace current] = $num\"\n","                                        }\n","\n","                    puts \"now num testProc1 = $num\"\n","\n","\n","                    proc testProc2 {} {\n","                        variable num\n","                        return \"num in testProc2 in namespace \\\n","                          [namespace current] = $num\"\n","                                      }\n","\n","                    puts \"now num testProc2 = $num\"\n","                    testProc1\n","                    testProc2\n","                    puts \"now num All = $num\"\n","                  }\n","puts \"now num out of namespace = $num\"\n","puts \"global num is still = $num\"\n","\n","#The commands and variables in this namespace are separate from other \\\n","commands and variables in the same program.\n","#• If there is a variable num in the global namespace, for example, it will be \\\n","different from the variable num in the test namespace.\n","puts \"#################################################\";\n","#new namespaces.example namespace eval\n","set num 5\n","puts \"global num = $num\"\n","\n","namespace eval test {\n","                     variable num 7\n","                      puts \"num in namespace [namespace current] = $num\"\n","                      proc testProc1 {} {\n","                                    variable num\n","                                    puts \"now num testProc1 = $num\"\n","                                    return \"num in testProc1 in namespace [namespace current] = $num\"\n","                             }\n","                    #puts \"now num testProc1 = $num\"\n","                    proc testProc2 {} {\n","                                      variable num\n","                                      puts \"now num testProc2 = $num\"\n","                                      return \"num in testProc2 in namespace [namespace current] = $num\"\n","                            }\n","                    #puts \"now num testProc2 = $num\"\n","                    testProc2\n","                    testProc1\n","                    #puts \"now num All = $num\"\n","                  }\n","#puts \"now num out of namespace = $num\"\n","puts \"global num is still = $num\"\n","\n","puts \"#################################################\";\n","\n","#Procedures\n","#• Tcl procedures similar to functions in C.\n","#• Procedures may take arguments and may return values.\n","#• The basic syntax for defining a procedure is: proc name argList body\n","#• Once a procedure is created, it is considered to be a command.\n","#• Called using its name, followed by a value for each of its arguments.\n","#• By default, the return value from a procedure is the result of the last command in its body.\n","#• However, to return another value, the return command may be used.\n","#• Flexible number of arguments can be used using the args argument for an argument list.\n","\n","\n","\n","#Procedures\n","#• Input:\n","proc sum_proc {a b} {\n","                      return [expr $a + $b]\n","                      }\n","\n","proc magnitude {num} {\n","                      if {$num > 0} {\n","                      return $num\n","                        }\n","\n","\n","set num [expr $num * (-1)]\n","            return $num\n","                }\n","set num1 12\n","set num2 14\n","set sum [sum_proc $num1 $num2]\n","\n","puts \"The sum is $sum\"\n","puts \"The magnitude of 3 is [magnitude 3]\"\n","puts \"The magnitude of -2 is [magnitude -2]\"\n","\n","\n","puts \"#################################################\";\n","proc sum_proc {args} {\n","                      if {[llength $args]==1} {\n","                      set args [lindex $args 0]\n","                        }\n","\n","                      set sum [lindex $args 0]\n","                      foreach value [lrange $args 1 end] {\n","                                      set sum [expr $value +$sum]\n","                                    }\n","                  return $sum\n","                  }\n","set num1 12\n","set num2 14\n","set num3 21\n","set num4 24\n","set numList [list $num1 $num2 $num3 $num4]\n","set sum [sum_proc $num1 $num2 $num3 $num4]\n","set numListSum [sum_proc $numList]\n","\n","puts \"The sum is $sum\"\n","puts \"The list sum is $numListSum\"\n","\n","puts \"#################################################\";\n","#Procedures - Advanced Examples\n","#• Eval Templex functions in  Tcl with Tcl \\\n","lists instead of Templex Vectors.\n","\n","proc evalTemplexMath { fname args } {\n","                                    hwi OpenStack\n","                                    set tt [::hw::GetT];\n","                                    hwi GetSessionHandle sess$tt\n","                                    sess$tt GetProjectHandle prj$tt\n","                                    prj$tt GetTemplexHandle t$tt\n","                                    set text2eval \"t$tt Evaluate \\\"$fname\\(\"\n","foreach arg $args {\n","                    if {[string is double $arg]} {\n","                              append text2eval ${arg},\n","                            } elseif {[llength $arg] > 1 && \\\n","                    [string is double [lindex [lsort -dictionary $arg] end]] == 1} {\n","                    append text2eval \"\\{[join $arg ,]\\},\"\n","                    } else {\n","                    append text2eval \\\\\\\"${arg}\\\\\\\",\n","                  }\n","                }\n","\n","\n","set text2eval [string range $text2eval 0 end-1]\n","append text2eval \"\\)\\\" false\"\n","set evaluateValue [eval $text2eval]\n","hwi CloseStack\n","return $evaluateValue\n","}\n","\n","#• Eval Templex functions in Tcl with Tcl lists instead of Templex Vectors.\n","#Local Maxima in Tcl\n","\n","#Local Maxima in Templex\n","{\n","a={1,2,3,2,2,5,6,-1,5}\n","{peaks(a,1)}\n","}\n","returns in Templex vector\n","{2,6}\n","\n","\n","set vec [ list 1 2 3 2 2 5 6 -1 5]\n","evalTemplexMath peaks $vec 1\n","returns $peaks\n","2 6\n","\n","set vec [ list 1 2 3 2 2 5 6 -1 5]\n","set rturn [evalTemplexMath peaks $vec 1]\n","puts $rturn\n","\n","\n","puts \"#################################################\";\n","#Procedures and Arrays - Advanced Examples\n","puts \"####################Procedures and Arrays - Advanced Examples ##############################\";\n","\n","array unset playerArr\n","variable playerArr\n","proc addPlayer {name rankTennis pricemoney rankMoney} {\n","                  variable playerArr\n","                  lappend playerArr(allPlayers) $name\n","                  set playerArr(pricemoney,$rankMoney) [list $name $pricemoney]\n","                  set playerArr(rankPlayer,$name) $rankTennis\n","                  set playerArr(rank,$rankTennis) $name\n","                }\n","addPlayer \"Novak Djokovic\" 2 150e6 1\n","addPlayer \"Rafael Nadal\" 1 125e6 2\n","addPlayer \"Roger Federer\" 3 90e6 3\n","\n","puts \"Top [llength $playerArr(allPlayers)] players are [join $playerArr(allPlayers) \", \"]\"\n","puts \"Highest Pricemoney = $[format %.2f [lindex $playerArr(pricemoney,1) 1]]\"\n","puts \"Won by = [set richestPlayer [lindex $playerArr(pricemoney,1) 0]]\"\n","puts \"Richest Player $richestPlayer ranked $playerArr(rankPlayer,$richestPlayer) in the World\"\n","puts \"3rd ranked player is $playerArr(rank,3)\"\n","\n","puts \"#################################################\";\n","\n","\n","#VIRTUAL\n","#Reading Files\n","#• Common read file Tcl options:\n","\n","Command                                 Effect\n","\n","set fIn [open $file r]                Open the file to read it\n","\n","while {![eof $fIn]}                   While the end of file is not reached\n","\n","gets $fIn strLine                     Returns next line content\n","\n","if {[gets $fIn strLine]>0}            If the line is not blank\n","\n","if {[string first \"string_pattern\"    If string_pattern exists in the reference string\n","\"ref_string\"] >-1}\n","\n","split \"string\" \"delimiter\"            Split the string with specified delimiter. Eg: split \"1 2 3 4 5\" \" \"\n","\n","close $fIn                            Close the file\n","\n","#VIRTUAL\n","#Writing Files\n","\n","#Command                                  Effect\n","\n","set fIn [open $file w]                    Open the file to overwrite it\n","\n","set fIn [open $file a]                    Open the file to write it in append mode\n","\n","puts $fIn $string                         Writes the string in the file\n","\n","close $fIn                                Close the file\n","\n","\n","#Write Format\n","#• In order to force a given string to respect a specific format, you need to use \\\n","format instruction.\n","\n","#• Input:\n","set Pi 3.1415926535\n","format %8.3f $Pi\n","format %-8.3f $Pi\n","format %8.2e $Pi\n","\n","\n","#File Management\n","#• Common File management Tcl options:\n","\n","#Command                                       Effect\n","info script                                    Return the script directory\n","glob *csv                                       Search for all csv files\n","glob -types f *                                 Return all files (use –types d for directories)\n","glob -directory \"C:/...\" *.csv;                 Search for all csv files in the defined directory\n","file extension $file                            Return the extension file\n","file dirname $file                              Return the file directory\n","file tail $file                                 Return the filename (without the directory)\n","file root $file                                 Return the complete filename without the extension\n","file exist $file                                Check if the file exists\n","file join $dir $filename                        Concat the dirname and the filename\n","file normalize $file                            Normalize « / » and « \\ »  directory conventions\n","\n","\n","##Writing and Parsing Text Files\n","##• Reading files into list:\n","\n","proc fileToList { filePathName {delEmptyLines 1}} {\n","                        if [catch {open $filePathName r} fileIdread] {\n","                        tk_messageBox -type ok \\\n","                          -icon warning \\\n","                          -message \"Could not open $filePathName !!\"\n","                            exit\n","                        } else {\n","                        set fileVar [read $fileIdread]\n","                        close $fileIdread\n","                          set fileList [split [set fileVar] \"\\n\"]\n","                  foreach line $fileList {\n","                          if {$delEmptyLines == 1} {\n","                            if {[regexp {^[ ]*$} $line] == 0} {\n","                                    lappend newFileList $line\n","                                    }\n","                            }\n","                          if {$delEmptyLines == 0} {\n","                                  lappend newFileList $line\n","                                                  }\n","                                  }\n","                    return $newFileList\n","                    }\n","}\n","\n","\n","#Writing and Parsing Text Files\n","\n","set lineList [fileToList\n","              {c:\\Home\\Daten\\Altair\\Training\\Customizing\\Data\\curve_data.\n","                dat}]\n","    array unset valueArr\n","          foreach line $lineList {\n","if [string match \"XYDATA, *\" $line] {\n","                  set curve [string trimleft $line \"XYDATA, \"]\n","                lappend valueArr(curveList) $curve\n","                }\n","\n","if {[string is double [lindex $line 0]]} {\n","                lappend valueArr($curve,x) [format %0.2f [lindex\n","                $line 0]]\n","                lappend valueArr($curve,y) [format %0.2f [lindex\n","                $line 1]]\n","              }\n","      }\n","\n","\n","    foreach curve $valueArr(curveList) {\n","    puts \"$curve x-vector = $valueArr($curve,x)\"\n","    puts \"$curve y-vector = $valueArr($curve,y)\"\n","    }\n","\n","\n","\n","#Writing and Parsing Text Files\n","#• Procedure to write a list to text file.\n","#• Each list element will be one line in the text file.\n","#• Allows easy collection of lines during a script using lappend.\n","\n","proc listToFile { listName fileName } {\n","              if [catch {open $fileName w} fileIdwrite] {\n","                    tk_messageBox -type ok \\\n","                        -icon warning \\\n","                        -message \"Could not write to file $fileName !!\"\n","                  exit\n","                } else {\n","                  foreach line $listName {\n","                          puts $fileIdwrite $line\n","                      }\n","                close $fileIdwrite\n","              }\n","}\n","\n","#Writing and Reading Arrays from Text Files\n","#• Input 1 (Procedures):\n","\n","proc arrayToFile {fileName arrayName } {\n","variable $arrayName\n","if [catch {open $fileName w} fileIdwrite] {\n","tk_messageBox -type ok \\\n","-icon warning \\\n","-message \"Could not write to file $fileName !!\"\n","exit\n","} else {\n","puts $fileIdwrite [array get $arrayName]\n","close $fileIdwrite\n","}\n","}\n","proc fileToArray { fileName arrayName} {\n","variable $arrayName\n","if [catch {open $fileName r} fileIdread] {\n","tk_messageBox -type ok \\\n","-icon warning \\\n","-message \"Could not open $fileName !!\"\n","exit\n","} else {\n","set fileVar [read $fileIdread]\n","close $fileIdread\n","array set $arrayName $fileVar\n","return $arrayName\n","}\n","}\n","\n","\n","#Writing and Reading Arrays from Text Files\n","array set valArr [list a 1 b 2 c 3]\n","arrayToFile array.txt valArr\n","fileToArray array.txt valArr2\n","puts \"Content valArr\"\n","parray valArr\n","puts \"Content valArr2\"\n","parray valArr2\n","\n","#Debugging\n","\n","#• Start Debugging with\n","::hwp::startPopUpLog\n","\n","Command                                           Effect\n","::hwp::startPopUpLog Creates \"logfile.txt\"        mit default message\n","                                          Options\n","-message <message>                                Message – Provide starting message – Default \"Start process ....\"\n","-runlog <0/1>                                     Log to logfile – Default 1 (Allows to turn-off logging completely)\n","-runpopup <0/1>                                   Show popup window – Default 1 (turn off popup completely)\n","-newlog <0/1>                                     Replace existing logfile – Default 1\n","-logfile <logfile with filepath>                  Path to logfile – Default is \"logfile.txt\" in Working Directory\n","-memorytrack <0/1>                                Lof memory used by the application – Default 1\n","\n","\n","#Note: Find debugging.tcl file at : ..\\01-Intro-to-Tcl-Tk\\Demo\\debugging.tcl\n","\n","\n","#Debugging\n","#• ::hwp::popUpLog\n","#• ::hwp::endPopUpLog\n","\n","Command                                       Effect\n","::hwp::popUpLog                               Show message in popup / Log message to logfile\n","                            Mandatory Option\n","-message <message>                            Show message in popup / Log message to logfile\n","::hwp::indPopUpLog                            Close Logfile / destroy popup and log final message to\n","                                Options\n","-message <message>                            Log final message to logfile\n","\n","\n","\n","\n","#tk_getOpenFile\n","#• tk_getOpenFile pops up a dialog box for the User to select a file to open.\n","#• Associated with the Open command in the File menu.\n","#• Its purpose is for the user to select an existing file only.\n","#• This dialog box does not open a file, it simply returns the filename \\\n","so that it can be used in your script.\n","\n","#tk_getOpenFile\n","#• Additional options can be used with the following format:\n","#• tk_getOpenFile ?option value ...?\n","#Example: Option –filetypes\n","\n","set types {\n","          {{Text Files} {.txt} }\n","            {{TCL Scripts} {.tcl}}\n","              {{All Files} {*.*} }\n","            }\n","set filename [tk_getOpenFile -filetypes $types]\n","\n","\n","#tk_getSaveFile\n","#• tk_getSaveFile pops up dialog box for User to select a file to save.\n","#• Associated with the Save as command in the File menu.\n","#• This dialog box does not save a file, it simply returns the filename so that it can be used in your script.\n","#• Behaves the same way as tk_getOpenFile procedure and has the same options.\n","#Example: Option –title\n","#Input:\n","set filename [tk_getSaveFile -title \"Select a File\"]\n","puts $filename\n","#Output: C:/Temp/workDir/command1.tcl\n","\n","#tk_chooseDirectory\n","#• tk_chooseDirectory pops up a dialog box for the User to select a directory.\n","#• Allows user to set a directory name to a variable to be used in a script.\n","#Example:\n","#Input:\n","set dirname [tk_chooseDirectory]\n","puts $dirname\n","#Output: C:/Temp/workDir\n","\n","\n","#tk_messageBox\n","#• tk_messageBox procedure creates and displays a message \\\n","window with an application-specified message, an icon, and a set of buttons.\n","#• The following example illustrates the tk_messageBox command with the message option.\n","#• This option allows you to specify the message to be displayed in the message box.\n","#Example:\n","#Input:\n","tk_messageBox -message \"This is the message to be displayed\"\n","\n","\n","#tk_dialog\n","#• tk_dialog procedure creates and displays a message window with \\\n","a user-specified message,an icon, and a set of buttons.\n","#• The following example illustrates the tk_dialog \\\n","command clicking “I’m not so sure”.\n","#Example:\n","#Input:\n","set reply [tk_dialog .foo \"The Title\" \"Do you want to say yes?\" \\\n","questhead 0 Yes No \"I'm not sure\"]\n","if {$reply == 0} {\n","                puts \"Go for it\"\n","                  } elseif {$reply == 1} {\n","                puts \"No go\"\n","                } elseif {$reply == 2} {\n","                puts \"Why do you bother?\"\n","  }\n","Output: Why do you bother?\n","\n","\n","#Overview\n","#• The Altair GUI Toolkit is a resource tool for coding Tcl/Tk dialogs with \\\n","‘Altair’ design flavour.\n","\n","\n","#File Name and Location:\n","#..\\01-Intro-to-Tcl-Tk\\Demo\\mat.txt\n","#Demo Goals:\n","\n","#1. Read material.txt file that contains a list of material, \\\n","with their corresponding density, Young Modulus and Poisson \\\n","coefficient.\n","\n","#2. Store Young Modulus, Density and Poisson coefficient in \\\n","array.\n","\n","#3. Write OptiStruct Solver Card for each material, each one\\\n","with a unique ID.\n","\n","#4. Input and Output file should be selected using Tk Widgets.\n","\n","#5. Set one procedure for reading material.txt and another \\\n","one for writing Solver Cards.\n","\n","\n","\n","####FILES##\n","#mat.txt\n","\n","Aluminium 2.7 69 .243\n","Steel 7.9 210 .3\n","Copper 8.96 124 .33\n","Gold 19.3 78 .42\n","\n","\n","#Test.tcl\n","\n","proc fileToList { filePathName {delEmptyLines  1}} {\n","    if [catch {open $filePathName r} fileIdread] {\n","\t\ttk_messageBox -type ok \\\n","\t\t\t\t\t  -icon warning \\\n","\t\t\t\t\t  -message \"Could not open $filePathName !!\"\n","\t\texit\n","    } else {\n","\t\tset fileVar [read $fileIdread]\n","\t\tclose $fileIdread\n","\t\tset fileList [split [set fileVar] \"\\n\"]\n","\t\tforeach line $fileList {\n","\t\t\tif {$delEmptyLines == 1} {\n","\t\t\t\tif {[regexp {^[ ]*$} $line] == 0} {\n","\t\t\t\t\tlappend newFileList $line\n","\t\t\t\t}\n","\t\t\t}\n","\t\t\tif {$delEmptyLines == 0} {\n","\t\t\t\tlappend newFileList $line\n","\t\t\t}\n","\t\t}\n","\t\treturn $newFileList\n","    }\n","}\n","set lineList [fileToList {c:\\Users\\mferrero\\Desktop\\HyperWork-Customization-and-Automation-v2022.1\\01-Intro-to-Tcl-Tk\\Demo\\curve_data.dat}]\n","array unset valueArr\n","foreach line $lineList {\n","\tif [string match \"XYDATA, *\" $line] {\n","\t\tset curve [string trimleft $line \"XYDATA, \"]\n","\t\tlappend valueArr(curveList) $curve\n","\t}\n","\tif {[string is double [lindex $line 0]]} {\n","\t\tlappend valueArr($curve,x) [format  %0.2f [lindex $line 0]]\n","\t\tlappend valueArr($curve,y) [format  %0.2f [lindex $line 1]]\n","\t}\n","}\n","foreach curve $valueArr(curveList) {\n","\tputs \"$curve x-vector = $valueArr($curve,x)\"\n","\tputs \"$curve y-vector = $valueArr($curve,y)\"\n","}\n","\n","#Curve_data.dat\n","\n","XYDATA, Curve 1\n","1.0000000000e+00    1.0000000000e+00\n","2.0000000000e+00    4.0000000000e+00\n","3.0000000000e+00    9.0000000000e+00\n","4.0000000000e+00    1.6000000000e+0