otalString\n","\t\t}\n","\t\tif {$popUpLogArray(runPopup)} {\n","\t\t\topenPopup $totalString\n","\t\t}\n","\t}\n","\n","\tset possibleOptions(popUpLog)  [list message]\n","\tset mandatoryOptions(popUpLog) [list message]\n","\tproc popUpLog {args} {\n","\t\tarray set opts [checkArgs $args popUpLog]\n","\t\tvariable popUpLogArray\n","\t\tset message $opts(message)\n","\t\tif {$popUpLogArray(memoryTrack)} {\n","\t\t\tset totalString \"[runTimePopUpLog] [hvMemoryUsage]: $message\"\n","\t\t} else {\n","\t\t\tset totalString \"[runTimePopUpLog]: $message\"\n","\t\t}\n","\t\tif {$popUpLogArray(runLog)} {\n","\t\t\twrite2PopUpLog   $totalString\n","\t\t}\n","\t\tif {$popUpLogArray(runPopup)} {\n","\t\t\tupdatePopup $totalString\n","\t\t}\n","\t}\n","\n","\tset possibleOptions(endPopUpLog)  [list message]\n","\tset mandatoryOptions(endPopUpLog) [list ]\n","\tproc endPopUpLog {args} {\n","\t\tarray set opts [checkArgs $args endPopUpLog]\n","\t\tvariable popUpLogArray\n","\t\tif {![info exists opts(message)]} {\n","\t\t\tset message \"Process finished!\"\n","\t\t}  else {\n","\t\t\tset message $opts(message)\n","\t\t}\n","\t\tif {$popUpLogArray(runPopup)} {\n","\t\t\t::hwt::PopdownWorkingWindow\n","\t\t}\n","\t\tset totalString \"[clock format [clock seconds] -format \"%d %b %Y %H:%M:%S\"] Total Runtime = [expr [clock seconds] - $popUpLogArray(timeStamp)] sec: $message\"\n","\t\tif {$popUpLogArray(runLog)} {\n","\t\t\twrite2PopUpLog   $totalString\n","\t\t}\n","\t}\n","\n","\tproc hvMemoryUsage {} {\n","\t\tglobal tcl_platform\n","\t\tvariable popUpLogArray\n","\t\tif {$popUpLogArray(memoryTrack)} {\n","\t\t\tif {$tcl_platform(platform) == \"windows\"} {\n","\t\t\t\tset memoryString \"HV [format %.3f [expr [[GetSession] GetMemoryUsage] / 1024.000]] KB\"\n","\t\t\t} else {\n","\t\t\t\tset memoryString \"\"\n","\t\t\t}\n","\t\t\treturn $memoryString\n","\t\t} else {\n","\t\t\treturn \"\"\n","\t\t}\n","\t}\n","\n","\tproc totalMemoryUsage {} {\n","\t\tvariable popUpLogArray\n","